# Core Django configuration
DEBUG=1
SECRET_KEY=dev-secret
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=https://*.github.dev,http://0.0.0.0:8000,http://localhost:8000
SITE_NAME=MetaGaP

# Logging defaults
# - Development keeps console logging on and disables file handlers by default.
# - Production (DEBUG=0) automatically enables rotating file handlers unless overridden.
LOG_LEVEL=INFO
DJANGO_REQUEST_LOG_LEVEL=ERROR
LOG_TO_CONSOLE=1
LOG_TO_FILE=0
LOG_DIR=logs
APP_LOG_FILE=application.log
DJANGO_REQUEST_LOG_FILE=django_requests.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Optional SMTP alerts (only configured when LOG_ENABLE_SMTP=1 and a host/to address are provided)
LOG_ENABLE_SMTP=0
LOG_SMTP_HOST=smtp.example.com
LOG_SMTP_PORT=587
LOG_SMTP_USERNAME=
LOG_SMTP_PASSWORD=
LOG_SMTP_FROM=
LOG_SMTP_TO=ops@example.com
LOG_SMTP_SUBJECT=MetaGap error notification
LOG_SMTP_USE_TLS=1
LOG_SMTP_LEVEL=ERROR

# Optional external APM/HTTP hook (uses Python's HTTPHandler)
LOG_APM_HOST=apm.example.com
LOG_APM_URL=/ingest/logs
LOG_APM_METHOD=POST
LOG_APM_USE_TLS=1
LOG_APM_LEVEL=ERROR
